# Copy to .env (git-ignored). docker compose reads it automatically; for `npm run dev`,
# export these in your shell or prefix the command.

# "Sign in with Google": create an OAuth client (type "Web application") in Google Cloud Console
# and add <PUBLIC_URL>/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the web app (used to build the redirect URI).
PUBLIC_URL=http://localhost:3000

# Required in production: a long random string, e.g. `openssl rand -base64 48`.
COOKIE_SECRET=
